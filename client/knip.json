{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/polyfills/*.js!"],
  "project": ["src/**/*.{js,jsx,ts,tsx,sass,scss}!", "scripts/**/*.{js,mjs}!"],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "unresolved",
    "binaries",
    "exports",
    "types",
    "duplicates",
    "cycles"
  ],
  "ignoreBinaries": ["rustc", "cc", "rsvg-convert"],
  "ignoreDependencies": [
    "lint-staged",
    "foxts",
    "@tauri-apps/plugin-http",
    "@tauri-apps/plugin-opener"
  ],
  "ignoreIssues": {
    "src/types/generated/**": ["exports", "types"]
  },
  "cycles": {
    "dynamicImports": true
  }
}
