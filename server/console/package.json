{
  "name": "chrysalis-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chrysalis admin console \u2014 manage codes, clients, releases and tiers from a browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "verify:mock": "node verify/mock-hub.mjs",
    "verify:serve": "vite --config verify/vite.verify.config.ts",
    "verify:drive": "node verify/drive.mjs",
    "verify:workflows": "node verify/workflows.mjs",
    "verify:audit": "node verify/audit.mjs",
    "verify:visual": "node verify/visual.mjs"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
