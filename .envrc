# .envrc — the one thing a local dev shell must not inherit.
#
# WHY THIS EXISTS. A shell that had a webkit2gtk 4.0 toolchain in
# LD_LIBRARY_PATH makes `cargo test` and `cargo tauri dev` fail at LINK time with
# an unrelated-looking symbol error, because the linker finds the 4.0 sonames
# before the 4.1 ones this Tauri 2 build needs. The repo cannot fix that for you:
# it is the parent process's environment. Clearing it here makes the failure
# impossible instead of diagnosable.
#
# Load with `direnv allow` (if you use direnv) or `set -a; . ./.envrc; set +a`.
# This file exports nothing secret — the operator secrets are elsewhere, see
# server/scripts/secrets-decrypt.sh.

unset LD_LIBRARY_PATH LD_PRELOAD

# The hub's own Caddy answers /api/* on both names; there is nothing to alias in
# /etc/hosts. If you ever add one, add it for BOTH names or neither — a partial
# alias is how a "works on my machine" activation bug gets born.
